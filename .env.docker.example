# ============================
# WMS Multi Gudang - Docker Environment Template
# ============================
# Copy this file to .env.docker and fill in your values:
#   cp .env.docker.example .env.docker
# ============================

# Database
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=wms
DB_USERNAME=wms_user
DB_PASSWORD=your_database_password

# Redis
REDIS_HOST=redis
REDIS_PASSWORD=null

# MinIO (S3-compatible storage)
MINIO_ROOT_USER=your_minio_access_key
MINIO_ROOT_PASSWORD=your_minio_secret_key

# Meilisearch
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=your_meilisearch_master_key

# Mail (optional)
MAIL_MAILER=smtp
MAIL_HOST=smtp
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null

# App
APP_NAME="WMS Multi Gudang"
APP_ENV=local
APP_DEBUG=true
APP_URL=http://localhost:8000

# Session
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_SECURE_COOKIE=false

# Queue and Broadcasting
QUEUE_CONNECTION=redis
BROADCAST_DRIVER=reverb
REVERB_APP_ID=your_reverb_app_id
REVERB_APP_KEY=your_reverb_app_key
REVERB_APP_SECRET=your_reverb_app_secret

# CORS - set specific origins for production
# ALLOWED_ORIGINS=https://example.com,https://admin.example.com
